# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://fairbazaar.in

# Analytics — loaded ONLY after the visitor grants analytics/marketing consent
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Google Search Console verification token (content of the meta tag)
NEXT_PUBLIC_GSC_VERIFICATION=

# Booking (Calendly or similar). Leave empty to hide the embed.
NEXT_PUBLIC_BOOKING_URL=

# Lead routing (server-side only — never prefix with NEXT_PUBLIC_)
# POST JSON of each lead to your CRM / automation webhook (e.g. FairBazaar CRM, Zoho Flow, n8n)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
# Email notification via Resend (https://resend.com)
RESEND_API_KEY=
LEAD_NOTIFY_TO=
LEAD_NOTIFY_FROM=
# Newsletter provider webhook (Mailchimp/Brevo/ConvertKit bridge)
NEWSLETTER_WEBHOOK_URL=
